{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "packages/server/src/**/*.ts",
    "packages/connector-kit/src/**/*.ts",
    "connectors/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/client/src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["scripts/consumer"]
}
