# Copy to .env next to docker-compose.yml. Make each secret with the command beside it.
# Seals stored credentials: 32 random bytes, base64 (openssl rand -base64 32). Keep it: without
# it nothing saved can be opened again.
CONNECT_ENCRYPTION_KEY=
# The admin API's bearer token, 32+ characters (openssl rand -hex 32).
AGENT_CONNECT_ADMIN_TOKEN=
# The bundled Postgres's password, URL-safe (openssl rand -hex 24).
POSTGRES_PASSWORD=
# This deployment's public origin, for Teams bots (optional), e.g. https://agents.example.com
PUBLIC_BASE_URL=
# Names it shows and creates in tenants, as JSON (optional), e.g. {"productName":"Acme Agents"}
BRANDING=
